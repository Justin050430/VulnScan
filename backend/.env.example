# ============================================================
# VulnScan environment configuration (copy to backend/.env)
# NEVER commit the real .env file.  All secrets come from here.
# ============================================================

# ---- Flask ---------------------------------------------------
FLASK_ENV=development
# Change this to a long random string in production:
SECRET_KEY=change-me-to-a-long-random-secret
# JWT signing key (fallback = SECRET_KEY when blank):
JWT_SECRET_KEY=

# ---- Database (Microsoft SQL Server) -------------------------
# Option A - explicit connection string (overrides everything below):
# DATABASE_URL=mssql+pyodbc://user:pass@host:1433/VulnScan?driver=ODBC+Driver+17+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
#
# Option B - component based (default LocalDB for local development):
MSSQL_SERVER=(localdb)\MSSQLLocalDB
MSSQL_DATABASE=VulnScan
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
# Leave blank for Windows integrated (Trusted) authentication:
# MSSQL_USERNAME=
# MSSQL_PASSWORD=

# ---- Google OAuth 2.0 (Sign in with Google) ------------------
# Leave blank to disable Google sign-in on this instance.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered as an Authorized redirect URI in Google Cloud Console:
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ---- Scanner safety / limits ---------------------------------
SCANNER_TIMEOUT=10
SCANNER_MAX_PAGES=30
SCANNER_MAX_DEPTH=2
SCANNER_REQUEST_DELAY_MS=200
# Allow scanning private/loopback targets (needed for local test apps).
# Set to false in production to block SSRF against private networks.
SCANNER_ALLOW_PRIVATE_TARGETS=true

# ---- Default seed accounts (used only when none exist) --------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@vulnscan.local
SEED_ADMIN_PASSWORD=Admin@VulnScan2025
SEED_DEVELOPER_USERNAME=developer
SEED_DEVELOPER_EMAIL=developer@vulnscan.local
SEED_DEVELOPER_PASSWORD=Developer@VulnScan2025

# Run scans in a background thread (true) or synchronously (false):
SCAN_ASYNC=true
