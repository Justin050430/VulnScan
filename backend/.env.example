# ============================================================
# VulnScan environment configuration (copy to backend/.env)
# NEVER commit the real .env file.  All secrets come from here.
# ============================================================

# ---- Flask ---------------------------------------------------
FLASK_ENV=development
# Change this to a long random string in production:
SECRET_KEY=change-me-to-a-long-random-secret
# JWT signing key (fallback = SECRET_KEY when blank):
JWT_SECRET_KEY=

# ---- Database (Microsoft SQL Server) -------------------------
# Option A - explicit connection string (overrides everything below):
# DATABASE_URL=mssql+pyodbc://user:pass@host:1433/VulnScan?driver=ODBC+Driver+17+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
#
# Option B - component based (default LocalDB for local development):
MSSQL_SERVER=(localdb)\MSSQLLocalDB
MSSQL_DATABASE=VulnScan
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
# Leave blank for Windows integrated (Trusted) authentication:
# MSSQL_USERNAME=
# MSSQL_PASSWORD=

# ---- Google OAuth 2.0 (Sign in with Google) ------------------
# Leave blank to disable Google sign-in on this instance.
# Never put real credentials in this file: it is committed to version control.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered as an Authorized redirect URI in Google Cloud Console:
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ---- Scanner safety / limits ---------------------------------
SCANNER_TIMEOUT=10
SCANNER_MAX_PAGES=30
SCANNER_MAX_DEPTH=2
SCANNER_REQUEST_DELAY_MS=200
# Allow scanning private/loopback targets (needed for local test apps).
# Set to false in production to block SSRF against private networks.
SCANNER_ALLOW_PRIVATE_TARGETS=true
# Enable bounded time-based SQLi probes (slow: adds ~6s per tested parameter).
# Off by default; time-based testing is only used when other techniques are
# inconclusive.
SCANNER_ENABLE_TIME_BASED=false
# Test HTML form fields (GET and POST) in addition to query-string parameters.
# Forms containing password or file inputs, and forms with destructive actions
# (delete/payment/...), are never submitted. Set to false to keep the scanner
# query-string only.
SCANNER_ENABLE_FORM_TESTING=true

# ---- Reliability / hardening (F1/F2) --------------------------
# Startup recovery: mark scans interrupted by a restart as Failed so users
# are never stuck with a permanently "Running" scan.
SCANNER_RECOVER_ORPHAN_SCANS=true
# Active-scan concurrency caps (Pending + Running counted from the database);
# 0 disables a cap.
SCAN_MAX_ACTIVE_PER_USER=3
SCAN_MAX_ACTIVE_GLOBAL=5

# ---- Trust Boundary Extension ---------------------------------
# enforce = only project-scoped, trust-gated scans (production default)
# legacy  = historical POST /api/scans stays available (local compatibility
#           and regression tests only; never use in production)
TRUST_BOUNDARY_MODE=enforce
# Days a verified asset stays verified before re-verification.
TRUST_ASSET_VERIFICATION_DAYS=90
# Minutes a DNS TXT / well-known file challenge stays valid.
TRUST_VERIFICATION_TOKEN_MINUTES=30
# Attestation lifetime (days) and the maximum a caller may request.
TRUST_ATTESTATION_DEFAULT_DAYS=30
TRUST_ATTESTATION_MAX_DAYS=90
# Days a purchased scan credit stays usable.
TRUST_CREDIT_VALIDITY_DAYS=180
# Minutes a reserved credit waits for the scan worker to start.
TRUST_CREDIT_RESERVATION_MINUTES=15
# Mock provider only. No real payment gateway or real money.
TRUST_PAYMENT_PROVIDER=MOCK
TRUST_MOCK_PAYMENT_SECRET=mock-provider-not-a-real-secret
# Web-file verification limits (no real money or credentials involved).
TRUST_WEBFILE_TIMEOUT=8
TRUST_WEBFILE_MAX_BYTES=4096
# Port used when fetching /.well-known/vulnscan.txt. Assets store a hostname
# only, so local demos that run the controlled target on a non-default port set
# this (e.g. 5001). Leave 0 in production.
TRUST_WEBFILE_PORT=0

# ---- Temporary authenticated-scan credentials ------------------
# Fernet key used to encrypt test-account secrets at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Production must set this explicitly; development/tests derive a key from
# SECRET_KEY when it is blank.
TRUST_CREDENTIAL_KEY=
# Optional previous key, accepted for decryption during key rotation.
TRUST_CREDENTIAL_KEY_OLD=
# Credential lifetime defaults (hours) and the maximum a caller may request.
TRUST_CREDENTIAL_DEFAULT_HOURS=4
TRUST_CREDENTIAL_MAX_HOURS=24
# Minimum seconds between login tests for the same credential.
TRUST_CREDENTIAL_TEST_COOLDOWN_SECONDS=10
# Timeout for the credential login handshake.
TRUST_CREDENTIAL_TIMEOUT=10
# local demonstrations only: allow the creator to approve their own credential.
# Production should keep maker-checker enabled (false).
TRUST_CREDENTIAL_ALLOW_SELF_APPROVAL=false

# ---- Default seed accounts (used only when none exist) --------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@vulnscan.local
SEED_ADMIN_PASSWORD=Admin@VulnScan2025
SEED_DEVELOPER_USERNAME=developer
SEED_DEVELOPER_EMAIL=developer@vulnscan.local
SEED_DEVELOPER_PASSWORD=Developer@VulnScan2025

# Run scans in a background thread (true) or synchronously (false):
SCAN_ASYNC=true
